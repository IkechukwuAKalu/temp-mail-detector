{
  "name": "temp-mail-detector",
  "version": "0.1.4",
  "description": "A node module to detect temporary email addresses",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tslint -c tslint.json 'index.ts' 'lib/**/*.ts' '__tests__/**/*.ts'",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "coverage": "jest --coverage",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build && npm test"
  },

  "keywords": [
    "temp-mail",
    "disposable emails",
    "detector"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/IkechukwuAKalu/temp-mail-detector.git"
  },
  "author": "Ikechukwu Kalu",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^26.0.19",
    "@types/node": "^14.14.12",
    "jest": "^26.6.3",
    "ts-jest": "^26.4.4",
    "tslint": "^6.1.3",
    "typescript": "^4.1.2"
  },
  "dependencies": {}
}

